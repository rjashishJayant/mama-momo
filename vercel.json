{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/(mama-momo.*|loader-momo.*|favicon.*|apple-touch-icon.*|qrcode.*|mama_momo_qr.*|qr-card\\.html)$",
      "dest": "/$1"
    },
    {
      "src": "^/$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/menu/?$",
      "dest": "/api/menu.php"
    },
    {
      "src": "^/checkout/?$",
      "dest": "/api/checkout.php"
    },
    {
      "src": "^/confirm/?$",
      "dest": "/api/confirm.php"
    },
    {
      "src": "^/vendor/?$",
      "dest": "/api/vendor.php"
    }
  ]
}
